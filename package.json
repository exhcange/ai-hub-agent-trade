{
  "name": "ai-hub-agent-trade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.1.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @ai-hub/agent-trade-core build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "clean": "pnpm -r --if-present clean",
    "release-check": "pnpm typecheck && pnpm test && node scripts/check-denylist.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
